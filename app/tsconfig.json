{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["server/**/*.ts", "test/**/*.ts", "client/**/*.ts"]
}
