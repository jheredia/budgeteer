{
  "name": "budgeteer-m2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && node --import tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "setup": "node --import tsx server/setup.ts",
    "build": "tsc --noEmit && esbuild client/main.ts --bundle --format=esm --target=es2022 --outfile=dist/client.js && esbuild server/imports/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/import-worker.mjs",
    "configure": "node --import tsx server/configure.ts",
    "test:browser": "node --import tsx test/browser-proof.ts",
    "pretest": "npm run build",
    "test:financial-browser": "npm run build && node --import tsx test/financial-browser-proof.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "better-auth": "1.7.12",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "mailparser": "3.14.2",
    "parse5": "8.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
